# --- Server ---
PORT=3000
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=60
FRONTEND_URL=https://affynelabs.com

# --- Security ---
# Secret key required to access administrative endpoints (e.g. /api/emails, /api/waitlist/export)
ADMIN_API_KEY=your_secure_admin_api_key_here

# --- Firebase Configuration ---
FIREBASE_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:web:abcdef
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: Path to service account JSON if using Admin SDK
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# --- Firestore Collections & Documents ---
WAITLIST_COLLECTION=waitlist
EMAILS_COLLECTION=emails
SUBSCRIBERS_COLLECTION=subscribers
ALL_EMAILS_DOC=meta/all_emails

# --- Reference number format: WL-00001, WL-00002, ... ---
REFERENCE_PREFIX=WL-
REFERENCE_DIGITS=5

# --- Google SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@yourdomain.com
SMTP_PASS=xxxxxxxxxxxxxxxx
MAIL_FROM="Affyne Labs <no-reply@auth.affynelabs.com>"

# --- Email content ---
EMAIL_SUBJECT="You're on the Affyne Labs waiting list, {{name}}!"
DATE_LOCALE=en-IN
DATE_TIMEZONE=Asia/Kolkata
