rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // AFFYNE LABS - ZERO-LEAK FIRESTORE SECURITY RULES
    // =========================================================================
    // PURPOSE:
    // 1. Prevent ANY external user, bot, or script from reading/copying data.
    // 2. Prevent ANY external user from deleting records.
    // 3. Prevent ANY external user from tampering with or updating records.
    // 4. Protect all sensitive collections (subscribers, meta, emails, inquiries).
    // =========================================================================

    // -------------------------------------------------------------------------
    // DEFAULT RULE: DENY ALL EXTERNAL ACCESS
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // STRICT COLLECTION-SPECIFIC SHIELDS
    // -------------------------------------------------------------------------

    // Internal Metadata, Counters & All Emails List (ABSOLUTELY NO PUBLIC ACCESS)
    match /meta/{document=**} {
      allow read, write: if false;
    }

    // Subscribers Collection (ABSOLUTELY NO PUBLIC ACCESS)
    match /subscribers/{document=**} {
      allow read, write: if false;
    }

    // Email Delivery Logs (ABSOLUTELY NO PUBLIC ACCESS)
    match /emails/{document=**} {
      allow read, write: if false;
    }

    // Inquiries Collection (No public reading, updating, or deleting)
    match /inquiries/{document=**} {
      allow read, update, delete: if false;
    }

    // Waitlist Collection (No external reading, copying, updating, or deleting)
    match /waitlist/{docId} {
      // FORBID ALL READS: Prevents database copying, scraping, and enumeration attacks
      allow read: if false;

      // FORBID ALL DELETIONS: Guarantees no data can ever be deleted externally
      allow delete: if false;

      // FORBID ALL UPDATES: Prevents modification of existing records
      allow update: if false;

      // When writes are routed through your backend server using Firebase Admin SDK,
      // the Admin SDK bypasses these rules with full administrative security.
      // If direct web client submission is ever required without backend:
      allow create: if false; // Kept strictly false so ONLY your backend can write
    }
  }
}

